# Secrets - never commit
.env
.secrets/
*.token.json
tokens.json

# Local scratch. The Yahoo API agreement forbids storing or caching Yahoo
# Fantasy Information, so nothing from Yahoo is written here - only the
# public NBA schedule feed.
.cache/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/

# Reports contain Yahoo Fantasy Information (rosters, player stats). The API
# agreement forbids displaying, sharing or distributing that to third parties,
# and this repo is public - so reports stay local, always.
reports/*
!reports/.gitkeep
