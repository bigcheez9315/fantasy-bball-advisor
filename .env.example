# Yahoo app credentials — create an app at https://developer.yahoo.com/apps/create/
# API Permissions: Fantasy Sports -> Read (or Read/Write if you want the tool to
# place claims for you later). Redirect URI: oob
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=oob

# Filled in by `python -m fantasy init` (or set by hand)
LEAGUE_KEY=
TEAM_KEY=
