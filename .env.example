# Yahoo app credentials from https://developer.yahoo.com/apps/create/
#   Application Type / OAuth Client Type: Confidential Client
#   API Permissions: tick "Fantasy Sports - Read" (leave OpenID Connect and
#     TW Auction unchecked - neither is needed to read your league)
#   Redirect URI(s): https://localhost:8080
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Must match a Redirect URI on the Yahoo app exactly, including port.
# Nothing needs to listen there: you paste back the URL Yahoo redirects to.
YAHOO_REDIRECT_URI=https://localhost:8080

# Filled in by `python -m fantasy init`
LEAGUE_KEY=
TEAM_KEY=
