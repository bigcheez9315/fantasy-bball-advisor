# Yahoo app credentials from https://developer.yahoo.com/apps/create/
#   OAuth Client Type: Confidential Client  (this is what issues a secret)
#   API Permissions: tick "Fantasy Sports - Read". Leave OpenID Connect and
#     TW Auction unchecked - neither is needed to read your league.
#   Redirect URI(s): put anything; Yahoo ignores it for the flow we use.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# Leave this as "oob" (out-of-band): Yahoo shows you a code to paste instead
# of redirecting anywhere. Yahoo REJECTS localhost and 127.0.0.1 redirect URIs
# outright -- it only accepts oob or a publicly resolvable https host you own -
# so a local callback server is not an option here.
YAHOO_REDIRECT_URI=oob

# Filled in by `python -m fantasy init`
LEAGUE_KEY=
TEAM_KEY=
